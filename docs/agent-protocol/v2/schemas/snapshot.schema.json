{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://battleplan.app/agent-protocol/v2/schemas/snapshot.schema.json",
  "title": "Signed lossless stream snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["signed", "signature"],
  "properties": {
    "signed": {
      "type": "object",
      "allOf": [
        { "$ref": "envelope.schema.json" },
        {
          "type": "object",
          "properties": {
            "message_type": { "const": "snapshot" },
            "target": { "type": "object", "properties": { "kind": { "const": "stream" } } },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["stream_id", "high_water_mark", "generated_at", "entities"],
              "properties": {
                "stream_id": { "$ref": "envelope.schema.json#/$defs/identity" },
                "high_water_mark": { "$ref": "envelope.schema.json#/$defs/decimalCounter" },
                "generated_at": { "$ref": "temporal-profile.schema.json#/$defs/dateTime" },
                "entities": {
                  "type": "array",
                  "maxItems": 10000,
                  "items": { "oneOf": [{ "$ref": "#/$defs/resolved" }, { "$ref": "#/$defs/conflicted" }] }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "signature": { "$ref": "signature.schema.json" }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["state", "entity_kind", "entity_public_id"],
      "properties": {
        "state": { "enum": ["resolved", "conflicted"] },
        "entity_kind": { "enum": ["task", "worklog", "project"] },
        "entity_public_id": { "$ref": "envelope.schema.json#/$defs/publicId" }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "projection", "tombstone"],
      "properties": {
        "revision": { "$ref": "revision.schema.json" },
        "projection": { "type": "object", "maxProperties": 64 },
        "tombstone": { "type": "boolean" }
      }
    },
    "resolved": {
      "allOf": [
        { "$ref": "#/$defs/identity" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "entity_kind", "entity_public_id", "revision", "projection", "tombstone"],
          "properties": {
            "state": { "const": "resolved" },
            "entity_kind": { "enum": ["task", "worklog", "project"] },
            "entity_public_id": { "$ref": "envelope.schema.json#/$defs/publicId" },
            "revision": { "$ref": "revision.schema.json" },
            "projection": { "type": "object", "maxProperties": 64 },
            "tombstone": { "type": "boolean" }
          }
        }
      ]
    },
    "conflicted": {
      "allOf": [
        { "$ref": "#/$defs/identity" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "entity_kind", "entity_public_id", "conflict_set_id", "conflict_versions"],
          "properties": {
            "state": { "const": "conflicted" },
            "entity_kind": { "enum": ["task", "worklog", "project"] },
            "entity_public_id": { "$ref": "envelope.schema.json#/$defs/publicId" },
            "conflict_set_id": { "$ref": "envelope.schema.json#/$defs/sha256" },
            "conflict_versions": {
              "type": "array",
              "minItems": 2,
              "maxItems": 32,
              "items": { "$ref": "#/$defs/version" }
            }
          }
        }
      ]
    }
  }
}
