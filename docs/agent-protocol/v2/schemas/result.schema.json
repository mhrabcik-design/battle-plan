{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://battleplan.app/agent-protocol/v2/schemas/result.schema.json",
  "title": "Signed exhaustive command result",
  "type": "object",
  "additionalProperties": false,
  "required": ["signed", "signature"],
  "properties": {
    "signed": {
      "type": "object",
      "allOf": [
        { "$ref": "envelope.schema.json" },
        {
          "type": "object",
          "properties": {
            "message_type": { "const": "result" },
            "target": { "type": "object", "properties": { "kind": { "const": "receiver" } } },
            "payload": {
              "oneOf": [
                { "$ref": "#/$defs/received" }, { "$ref": "#/$defs/awaitingApproval" },
                { "$ref": "#/$defs/retryScheduled" }, { "$ref": "#/$defs/applied" },
                { "$ref": "#/$defs/blocked" }, { "$ref": "#/$defs/stale" },
                { "$ref": "#/$defs/expired" }, { "$ref": "#/$defs/rejected" },
                { "$ref": "#/$defs/quarantined" }
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "signature": { "$ref": "signature.schema.json" }
  },
  "$defs": {
    "state": { "enum": ["received", "awaiting_approval", "retry_scheduled", "applied", "rejected", "expired", "blocked", "stale", "quarantined"] },
    "errorCode": { "enum": [
      "invalid_json", "duplicate_json_key", "non_canonical_json", "payload_too_large", "schema_invalid",
      "unsupported_major", "unknown_message_type", "unknown_action", "signature_missing", "signature_invalid",
      "signature_metadata_mismatch", "public_key_fingerprint_mismatch", "key_unknown", "key_revoked",
      "workspace_mismatch", "producer_mismatch", "target_mismatch", "message_expired", "policy_blocked",
      "capability_blocked", "revision_stale", "revision_conflict", "approval_stale", "idempotency_conflict",
      "idempotency_horizon_expired", "transport_retryable", "external_effect_failed"
    ] },
    "commandId": { "$ref": "envelope.schema.json#/$defs/uuid" },
    "received": {
      "type": "object", "additionalProperties": false, "required": ["command_id", "state"],
      "properties": { "command_id": { "$ref": "#/$defs/commandId" }, "state": { "const": "received" } }
    },
    "awaitingApproval": {
      "type": "object", "additionalProperties": false, "required": ["command_id", "state"],
      "properties": { "command_id": { "$ref": "#/$defs/commandId" }, "state": { "const": "awaiting_approval" } }
    },
    "retryScheduled": {
      "type": "object", "additionalProperties": false, "required": ["command_id", "state", "error_code", "retry_at"],
      "properties": {
        "command_id": { "$ref": "#/$defs/commandId" }, "state": { "const": "retry_scheduled" },
        "error_code": { "const": "transport_retryable" }, "retry_at": { "$ref": "temporal-profile.schema.json#/$defs/dateTime" }
      }
    },
    "applied": {
      "type": "object", "additionalProperties": false,
      "required": ["command_id", "state", "entity_public_id", "revision"],
      "properties": {
        "command_id": { "$ref": "#/$defs/commandId" }, "state": { "const": "applied" },
        "entity_public_id": { "$ref": "envelope.schema.json#/$defs/publicId" },
        "revision": { "$ref": "revision.schema.json" },
        "effects": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/effect" } }
      }
    },
    "blocked": {
      "type": "object", "additionalProperties": false, "required": ["command_id", "state", "error_code"],
      "properties": {
        "command_id": { "$ref": "#/$defs/commandId" }, "state": { "const": "blocked" },
        "error_code": { "enum": ["policy_blocked", "capability_blocked"] }
      }
    },
    "stale": {
      "type": "object", "additionalProperties": false, "required": ["command_id", "state", "error_code"],
      "properties": {
        "command_id": { "$ref": "#/$defs/commandId" }, "state": { "const": "stale" },
        "error_code": { "enum": ["revision_stale", "revision_conflict", "approval_stale"] }
      }
    },
    "expired": {
      "type": "object", "additionalProperties": false, "required": ["command_id", "state", "error_code"],
      "properties": {
        "command_id": { "$ref": "#/$defs/commandId" }, "state": { "const": "expired" },
        "error_code": { "enum": ["message_expired", "idempotency_horizon_expired"] }
      }
    },
    "rejected": {
      "type": "object", "additionalProperties": false, "required": ["command_id", "state", "error_code"],
      "properties": {
        "command_id": { "$ref": "#/$defs/commandId" }, "state": { "const": "rejected" },
        "error_code": { "const": "idempotency_conflict" }
      }
    },
    "quarantined": {
      "type": "object", "additionalProperties": false, "required": ["command_id", "state", "error_code"],
      "properties": {
        "command_id": { "$ref": "#/$defs/commandId" }, "state": { "const": "quarantined" },
        "error_code": { "enum": [
          "invalid_json", "duplicate_json_key", "non_canonical_json", "payload_too_large", "schema_invalid",
          "unsupported_major", "unknown_message_type", "unknown_action", "signature_missing", "signature_invalid",
          "signature_metadata_mismatch", "public_key_fingerprint_mismatch", "key_unknown", "key_revoked",
          "workspace_mismatch", "producer_mismatch", "target_mismatch"
        ] }
      }
    },
    "effect": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["effect_id", "kind", "state"],
          "properties": {
            "effect_id": { "$ref": "envelope.schema.json#/$defs/uuid" },
            "kind": { "enum": ["calendar", "google_tasks", "drive_publication"] },
            "state": { "enum": ["pending", "succeeded"] }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["effect_id", "kind", "state", "error_code"],
          "properties": {
            "effect_id": { "$ref": "envelope.schema.json#/$defs/uuid" },
            "kind": { "enum": ["calendar", "google_tasks", "drive_publication"] },
            "state": { "const": "failed" },
            "error_code": { "enum": ["transport_retryable", "external_effect_failed"] }
          }
        }
      ]
    }
  }
}
