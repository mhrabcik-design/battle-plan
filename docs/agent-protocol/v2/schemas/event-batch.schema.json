{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://battleplan.app/agent-protocol/v2/schemas/event-batch.schema.json",
  "title": "Signed ordered event batch",
  "type": "object", "additionalProperties": false, "required": ["signed", "signature"],
  "properties": {
    "signed": {
      "type": "object",
      "allOf": [
        { "$ref": "envelope.schema.json" },
        { "type": "object", "properties": {
          "message_type": { "const": "event-batch" },
          "target": { "type": "object", "properties": { "kind": { "const": "stream" } } },
          "payload": {
            "type": "object", "additionalProperties": false,
            "required": ["stream_id", "sequence_from", "sequence_to", "events"],
            "properties": {
              "stream_id": { "$ref": "envelope.schema.json#/$defs/identity" },
              "sequence_from": { "$ref": "envelope.schema.json#/$defs/decimalCounter" },
              "sequence_to": { "$ref": "envelope.schema.json#/$defs/decimalCounter" },
              "events": { "type": "array", "minItems": 1, "maxItems": 250, "items": { "$ref": "#/$defs/event" } }
            }
          }
        } }
      ],
      "unevaluatedProperties": false
    },
    "signature": { "$ref": "signature.schema.json" }
  },
  "$defs": {
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "sequence", "event_type", "entity_kind", "entity_public_id", "revision", "occurred_at", "actor", "origin", "cause_id", "projection"],
      "properties": {
        "event_id": { "$ref": "envelope.schema.json#/$defs/uuid" },
        "sequence": { "$ref": "envelope.schema.json#/$defs/decimalCounter" },
        "event_type": { "enum": ["entity_created", "entity_updated", "entity_deleted", "conflict_detected", "conflict_resolved"] },
        "entity_kind": { "enum": ["task", "worklog", "project"] },
        "entity_public_id": { "$ref": "envelope.schema.json#/$defs/publicId" },
        "revision": { "$ref": "revision.schema.json" },
        "conflict_heads": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "envelope.schema.json#/$defs/sha256" } },
        "occurred_at": { "type": "string", "format": "date-time" },
        "actor": { "$ref": "envelope.schema.json#/$defs/identity" },
        "origin": { "enum": ["ui", "voice", "hermes", "drive", "google"] },
        "cause_id": { "$ref": "envelope.schema.json#/$defs/uuid" },
        "projection": { "type": "object", "maxProperties": 64 }
      },
      "allOf": [
        { "if": { "properties": { "event_type": { "enum": ["conflict_detected", "conflict_resolved"] } } }, "then": { "required": ["conflict_heads"] } }
      ]
    }
  }
}
